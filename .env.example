APP_NAME=AutoFacture
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=autofacture
DB_USERNAME=autofacture
DB_PASSWORD=autofacture

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@autofacture.local
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,127.0.0.1,127.0.0.1:80
SESSION_DOMAIN=
TRUSTED_PROXIES="*"
CRON_JOB_AUTH_TOKEN=

FEATURE_DASHBOARD=true
FEATURE_CUSTOMERS=true
FEATURE_ITEMS=true
FEATURE_ESTIMATES=true
FEATURE_INVOICES=true
FEATURE_ELECTRONIC_INVOICING=true
FEATURE_DOCUMENT_TEMPLATES=true
FEATURE_ACCOUNTING=true
FEATURE_MICRO_ENTREPRENEUR=true
FEATURE_PAYMENTS=true
FEATURE_USERS=true
FEATURE_SETTINGS=true
FEATURE_RECURRING_INVOICES=false
FEATURE_EXPENSES=false
FEATURE_REPORTS=false
FEATURE_MODULES=false
FEATURE_ADVANCED_ROLES=false
FEATURE_EXCHANGE_RATES=false
FEATURE_CUSTOM_FIELDS=false
FEATURE_IN_APP_UPDATE=false
FEATURE_MAIL_CONFIGURATION=false
FEATURE_FILE_DISK=false
FEATURE_BACKUP=false

EINVOICING_DEFAULT_PROVIDER=superpdp
SUPERPDP_ENVIRONMENT=sandbox
SUPERPDP_PORTAL_URL=https://www.superpdp.tech
SUPERPDP_DOCUMENTATION_URL=https://www.superpdp.tech/documentation/
# Renseigner ces valeurs uniquement après validation dans la documentation officielle SUPER PDP.
SUPERPDP_TEST_URL=
SUPERPDP_CLIENT_ID_HEADER=
SUPERPDP_CLIENT_SECRET_HEADER=
SUPERPDP_TIMEOUT=10

# L’envoi de déclarations micro-entrepreneur reste désactivé tant qu’AutoFacture
# n’a pas obtenu l’habilitation officielle de tiers déclarant et son jeton d’accès.
URSSAF_MICRO_DECLARATION_ENABLED=false
URSSAF_MICRO_DECLARATION_BASE_URL=
URSSAF_MICRO_DECLARATION_CLIENT_ID=
URSSAF_MICRO_DECLARATION_CLIENT_SECRET=

AI_ENABLED=false
AI_DEFAULT_PROVIDER=rules
AI_CLOUD_FALLBACK=false
OPENAI_MODEL=gpt-5.4-nano
LOCAL_AI_BASE_URL=http://host.docker.internal:11434
LOCAL_AI_MODEL=qwen3:1.7b
